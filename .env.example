# 复制成 .env 或直接设成系统环境变量；不配置也能跑（只是不生成笔记）
#
# 大模型：任何 OpenAI 兼容接口都行（只用于把逐字稿整理成笔记）
SHIKE_PROXY=https://api.openai.com/v1
SHIKE_MODEL=gpt-4o-mini
SHIKE_PROXY_KEY=sk-xxxxxxxxxxxxxxxx
# 密钥也可以写进同目录的 _local_key.txt（只有一行），别提交到仓库

# ffmpeg / ffprobe 路径：默认先找 PATH，再找包内 tools/ffmpeg/bin
# SHIKE_FFMPEG=
# SHIKE_FFPROBE=

# 抽帧间隔（秒）。默认按片长分档：≥180s 用 15、60~180s 用 8、<60s 用 3；
# 显式设置后固定用它，不再分档
# SHIKE_SLIDE_STEP=15
# 最多保留张数（默认 110），超出按倍数抽样
# SHIKE_SLIDE_MAX=110

# 导出 PDF 用的 LibreOffice（可选，找不到就只出 docx）
# SHIKE_NODE=
# SHIKE_LO_CLI=

# 回看.html 里的视频：默认 ≤300MB 就复制一份进输出目录（整个目录拷走还能播）；
# 设 SHIKE_WEB_COPY=0 则不复制，直接用绝对 file:// 路径
# SHIKE_WEB_COPY=1
# SHIKE_WEB_COPY_LIMIT=314572800

# 可选依赖（不装也能跑）：pip install faster-whisper / pip install rapidocr-onnxruntime
# 装了 faster-whisper 就可以省略 -t，由它现场转写；--asr-model small、--lang zh 可调
# 断网/离线时：--asr-model 也可以填本地已下载的模型目录，例如 --asr-model D:\models\small
# 可选 ASR 的推理设备：cpu（默认）/ cuda
# SHIKE_ASR_DEVICE=cpu
# 画面差异阈值上限（默认 3.2）
# SHIKE_SLIDE_DIFF=3.2
